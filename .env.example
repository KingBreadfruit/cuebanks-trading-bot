# ─── Deriv MT5 credentials ───────────────────────────
# Paper trading = Deriv MT5 DEMO account
# Live trading  = Deriv MT5 REAL account (swap these values when going live)
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_trading_password
MT5_SERVER=DerivDemo-Server

# Optional — path to terminal64.exe if it isn't auto-detected
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
